{
  "name": "hrms-product",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant HRMS monorepo (frontend, backend, shared)",
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run build -w @hrms/shared && concurrently -k -n FRONTEND,BACKEND -c cyan,green \"npm run dev -w @hrms/frontend\" \"npm run dev -w @hrms/backend\"",
    "dev:frontend": "npm run dev -w @hrms/frontend",
    "dev:backend": "npm run dev -w @hrms/backend",
    "dev:backend:refactor": "npm run dev:refactor -w @hrms/backend",
    "dev:shared": "npm run dev -w @hrms/shared",
    "seed": "npm run seed -w @hrms/backend",
    "build": "npm run build -w @hrms/shared && npm run build -w @hrms/frontend",
    "build:shared": "npm run build -w @hrms/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "npm run build -w @hrms/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
