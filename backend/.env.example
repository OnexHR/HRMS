# Copy to `.env` and adjust for your environment. Never commit `.env`.

PORT=4000

# The migrated backend connects to a real MongoDB instance before listening.
MONGODB_URI=mongodb://127.0.0.1:27017/hrms
# MONGO_URI=mongodb://127.0.0.1:27017/hrms

# Set a private random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
EMPLOYEE_JWT_EXPIRES_IN=7d

# Required System Admin created by `npm run seed`; no built-in credentials.
EMPLOYEE_ADMIN_EMAIL=
EMPLOYEE_ADMIN_PASSWORD=

# Demo staff are not seeded unless explicitly enabled. Set a strong password
# when SEED_DEMO=true.
SEED_DEMO=false
EMPLOYEE_DEMO_PASSWORD=
EMPLOYEE_DEMO_MANAGER_EMAIL=manager@test.com
EMPLOYEE_DEMO_EMPLOYEE_EMAIL=employee@test.com

# Optional profile/attachment storage (Cloudflare R2).
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Attendance policy overrides (minutes). Optional.
EMPLOYEE_STANDARD_DAY_MINUTES=

