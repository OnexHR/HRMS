# Copy to `.env` and adjust for your environment. Never commit `.env`.

NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/hrms

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Placeholder only. Never use this value outside local development.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Single-organization tenant seam (Stage 1). The seed resolves or creates this
# organization by slug. ORGANIZATION_ID is optional; set it to pin the record.
ORGANIZATION_ID=
ORGANIZATION_NAME=Example Organization
ORGANIZATION_SLUG=example-org

# Initial administrator created by the seed. Required; there are no built-in
# default credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Upload policy used by the files module (Stage 1, Phase A4).
MAX_UPLOAD_MB=10

# Attendance policy override. Stage 1 defaults to Asia/Kolkata.
HRMS_TZ=Asia/Kolkata
