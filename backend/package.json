{
  "name": "@hrms/backend",
  "version": "1.0.0",
  "private": true,
  "description": "HRMS REST API (Express + MongoDB)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/seedEmployees.mjs",
    "start:refactor": "node src/server.js",
    "dev:refactor": "node --watch src/server.js",
    "seed:refactor": "node src/seed/seed.js",
    "lint": "eslint src --config ../eslint.config.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.991.0",
    "@aws-sdk/s3-request-presigner": "^3.991.0",
    "@hrms/shared": "*",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
